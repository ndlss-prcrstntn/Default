<Project>
  <PropertyGroup>
    <!-- Source of truth: src/VERSION (semver MAJOR.MINOR.PATCH). Bump on each shipped change. -->
    <AppVersion Condition="Exists('$(MSBuildThisFileDirectory)VERSION')">$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)VERSION').Trim())</AppVersion>
    <AppVersion Condition="'$(AppVersion)' == ''">0.0.0</AppVersion>
    <Version>$(AppVersion)</Version>
    <AssemblyVersion>$(AppVersion).0</AssemblyVersion>
    <FileVersion>$(AppVersion).0</FileVersion>
    <InformationalVersion>$(AppVersion)</InformationalVersion>
  </PropertyGroup>
</Project>
